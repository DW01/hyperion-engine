{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (macOS or Linux)",
      "type": "shell",
      "command": "Tools/Scripts/BuildHyperion.sh",
      "args": [
        "nowait"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build (Windows)",
      "type": "shell",
      "command": "Tools\\Scripts\\BuildHyperion.bat",
      "args": [
        "nowait"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ],
}
