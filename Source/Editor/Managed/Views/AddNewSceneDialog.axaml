<Window
    x:Class="Hyperion.Editor.Views.AddNewSceneDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Hyperion.Editor.ViewModels;assembly=Hyperion.Editor"
    Width="380"
    SizeToContent="Height"
    x:DataType="vm:AddNewSceneDialogViewModel"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel>
        <Border
            DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button
                    Padding="20,6"
                    Click="OnCancel"
                    Content="Cancel" />
                <Button
                    Padding="20,6"
                    Click="OnConfirm"
                    Classes="Primary"
                    Content="Create Scene" />
            </StackPanel>
        </Border>

        <ScrollViewer Padding="4,0">
            <StackPanel Margin="12,12,12,8" Spacing="12">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Add New Scene" />

                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="11"
                        Opacity="0.7"
                        Text="Scene Name" />
                    <TextBox
                        Text="{Binding SceneName, Mode=TwoWay}"
                        Watermark="Enter scene name..." />
                </StackPanel>

                <Separator />

                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Opacity="0.7"
                    Text="Scene Flags" />

                <ItemsControl ItemsSource="{Binding FlagEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FlagsPropertyViewModel+EnumFlagEntry">
                            <CheckBox
                                Margin="0,2,0,2"
                                Content="{Binding Title}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
